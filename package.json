{
  "name": "ai-anonymizer",
  "version": "1.0.0",
  "description": "\"# ai-anonymizer\"",
  "scripts": {
    "build:server": "cd mcp-server && uv sync",
    "build:client": "cd mcp-client && npm run build",
    "start:client": "cd mcp-client && npm run start",
    "start:mcp-server-remote": "cd mcp-server && npm run mcp:remote",
    "start:mcp-server-local": "cd mcp-server && npm run mcp:local",
    "inspect-server": "cd mcp-server && npm run inspect",
    "build": "npx npm-run-all build:server build:client",
    "start": "npx npm-run-all --parallel start:mcp-server-local start:client"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nitz88/ai-anonymizer.git"
  },
