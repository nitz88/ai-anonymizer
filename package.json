{
  "name": "ai-anonymizer",
  "version": "1.0.0",
  "description": "\"# ai-anonymizer\"",
  "main": "index.js",
  "scripts": {
    "build:server": "cd mcp-server && uv sync",
    "build:client": "cd mcp-client && npm run build",
    "run:client": "cd mcp-client && npm run start",
    "run:server": "cd mcp-server && uv run --with mcp main.py",
    "build": "npx npm-run-all build:server build:client",
    "start": "npx npm-run-all --parallel run:server run:client"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nitz88/ai-anonymizer.git"
  },
